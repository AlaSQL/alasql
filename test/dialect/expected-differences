# Expected differences between alasql and SQLite in the dialect test (#2593).
# Each entry: the case, the answer alasql gives today, SQLite 3.43.2's answer, and why they differ.
# The test fails when alasql gives another answer for a listed case. After an intended change,
# run `bun test/dialect/run.js --update`: it rewrites the answers and keeps every "why".
# Rows of a statement without ORDER BY are shown sorted.

SELECT 'a' || NULL
  alasql: [["a"]]
  sqlite: [[null]]
  why: Three-valued logic: || with NULL gives NULL in SQLite. 5.0 (#2597).

SELECT a, b, c FROM ni ORDER BY id
  alasql: [[NaN, NaN, NaN], [1, 1.5, 2]]
  sqlite: [[null, null, null], [1, 1.5, 2]]
  why: Fault: NULL into an INT, FLOAT or NUMBER column is stored as NaN (#2590). 5.0, breaking.md.

SELECT id FROM ni WHERE a IS NULL
  alasql: []
  sqlite: [[1]]
  why: Fault: NULL into an INT column is stored as NaN, so IS NULL misses it (#2590). 5.0, breaking.md.

SELECT NOT (NULL = 1)
  alasql: [[true]]
  sqlite: [[null]]
  why: Three-valued logic: alasql treats NULL as false here. SQLite's answer in 5.0 (#2597).

SELECT NULL AND FALSE
  alasql: [[undefined]]
  sqlite: [[0]]
  why: Three-valued logic: alasql treats NULL as false here. SQLite's answer in 5.0 (#2597).

SELECT NULL OR FALSE
  alasql: [[false]]
  sqlite: [[null]]
  why: Three-valued logic: alasql treats NULL as false here. SQLite's answer in 5.0 (#2597).

SELECT 2 IN (1, NULL)
  alasql: [[false]]
  sqlite: [[null]]
  why: Three-valued logic: alasql treats NULL as false here. SQLite's answer in 5.0 (#2597).

SELECT 2 NOT IN (1, NULL)
  alasql: [[true]]
  sqlite: [[null]]
  why: Three-valued logic: alasql treats NULL as false here. SQLite's answer in 5.0 (#2597).

SELECT id FROM t WHERE NOT (n = 5) ORDER BY id
  alasql: [[2], [3], [4], [5]]
  sqlite: [[2], [4], [5]]
  why: Three-valued logic: alasql treats NULL as false here. SQLite's answer in 5.0 (#2597).

SELECT ja.id AS a, jb.id AS b FROM ja JOIN jb ON ja.g = jb.g ORDER BY a, b
  alasql: [[1, 1], [1, 2], [2, 3], [3, 4], [4, 4]]
  sqlite: [[1, 1], [1, 2], [2, 3]]
  why: Three-valued logic: NULL = NULL joins rows. 5.0 (#2597).

SELECT ja.id AS a, jb.id AS b FROM ja LEFT JOIN jb ON ja.g = jb.g ORDER BY a, b
  alasql: [[1, 1], [1, 2], [2, 3], [3, 4], [4, 4]]
  sqlite: [[1, 1], [1, 2], [2, 3], [3, null], [4, null]]
  why: Three-valued logic: NULL = NULL joins rows. 5.0 (#2597).

SELECT MAX(s) FROM t
  alasql: [[undefined]]
  sqlite: [["c"]]
